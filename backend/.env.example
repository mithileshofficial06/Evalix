# Copy to backend/.env and fill in. backend/.env is gitignored.
# Keys are read ONLY by the backend; the extension never sees them.

MISTRAL_API_KEY=
NVIDIA_API_KEY=

# Models (override as needed)
MISTRAL_MODEL=ministral-14b-latest
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Hybrid reasoning models (Nemotron 3.x etc.): false = fast direct answers, true = think first (slower)
NVIDIA_ENABLE_THINKING=false
# Vision-capable models, used only when the agent can't read the page from the DOM and sends a screenshot
MISTRAL_VISION_MODEL=ministral-14b-latest
NVIDIA_VISION_MODEL=nvidia/nemotron-nano-12b-v2-vl

# MISTRAL | NVIDIA | AUTO (Mistral first, NVIDIA fallback) | MOCK
AI_PROVIDER=AUTO

# MOCK provider answers from the synthetic answer key — for testing the loop without keys.
EVALIX_ENABLE_MOCK=true
# Fraction of questions the mock answers correctly (0.0–1.0)
MOCK_ACCURACY=0.9

# Retry / timeout behaviour per provider
AI_TIMEOUT_SECONDS=15
AI_MAX_RETRIES=2
# AUTO: after a rate limit (429) the provider is skipped for this long (or its Retry-After)
AI_COOLDOWN_SECONDS=30

# Pages Evalix may operate on (comma-separated origins). Requests for any other page are rejected.
ALLOWED_PAGE_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
