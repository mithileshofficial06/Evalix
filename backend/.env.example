# Copy to backend/.env and fill in. backend/.env is gitignored.
# Keys are read ONLY by the backend; the extension never sees them.

MISTRAL_API_KEY=
NVIDIA_API_KEY=

# Models (override as needed)
MISTRAL_MODEL=mistral-small-latest
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# MISTRAL | NVIDIA | AUTO (Mistral first, NVIDIA fallback) | MOCK
AI_PROVIDER=AUTO

# MOCK provider answers from the synthetic answer key — for testing the loop without keys.
EVALIX_ENABLE_MOCK=true
# Fraction of questions the mock answers correctly (0.0–1.0)
MOCK_ACCURACY=0.9

# Retry / timeout behaviour per provider
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2

# Pages Evalix may operate on (comma-separated origins). Requests for any other page are rejected.
ALLOWED_PAGE_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
